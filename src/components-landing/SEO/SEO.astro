---
interface Props {
  title: string
  description: string
  image?: string
  canonicalURL?: string
}

const {
  title,
  description,
  image = '/img/LogoNeider.avif',
  canonicalURL: propCanonicalURL
} = Astro.props

const pathname = Astro.url.pathname || '/'
const site = Astro.site || 'https://neider.dev'
const canonicalURL = propCanonicalURL || new URL(pathname, site).toString()
const absoluteImage = image.startsWith('http') ? image : new URL(image, site).toString()
const currentYear = new Date().getFullYear()
---

<meta charset="UTF-8" />

<title>{title}</title>

<!-- Primary Meta Tags -->
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="theme-color" content="#012029" />
<meta
  name="keywords"
  content="Neider Nieto, ingeniero de sistemas, desarrollador web, frontend, backend, React, Astro, JavaScript, TypeScript, Node.js, PostgreSQL, portafolio, Colombia"
/>
<meta name="robots" content="index, follow, max-snippet:160, max-image-preview:large" />
<meta name="googlebot" content="index, follow" />
<meta name="author" content="Neider Nieto" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/img/LogoNeider.avif" />
<link rel="apple-touch-icon" href="/img/LogoNeider.avif" />
<meta name="msapplication-TileColor" content="#012029" />

<!-- Viewport & Responsive -->
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />

<!-- Open Graph / Facebook -->
<meta property="og:locale" content="es_ES" />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content="Neider Nieto - Portfolio" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Neider Nieto - Ingeniero de Sistemas" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImage} />
<meta name="twitter:image:alt" content="Neider Nieto - Ingeniero de Sistemas" />
<meta name="twitter:site" content="@NeiderNieto10" />
<meta name="twitter:creator" content="@NeiderNieto10" />

<!-- Structured Data - Person -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Neider Nieto",
  "url": "https://neider.dev",
  "image": absoluteImage,
  "sameAs": [
    "https://twitter.com/NeiderNieto10",
    "https://github.com/NesniDev",
    "https://linkedin.com/in/neidernieto"
  ],
  "jobTitle": "Ingeniero de Sistemas | Desarrollador Frontend",
  "worksFor": {
    "@type": "Organization",
    "name": "Freelance"
  },
  "description": description,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Boyacá",
    "addressCountry": "CO"
  },
  "knowsAbout": ["React", "Astro", "JavaScript", "TypeScript", "Node.js", "PostgreSQL", "HTML", "CSS", "Tailwind"]
})} />

<!-- Structured Data - WebSite -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Neider Nieto - Portfolio",
  "url": "https://neider.dev",
  "description": description,
  "author": {
    "@type": "Person",
    "name": "Neider Nieto"
  }
})} />
