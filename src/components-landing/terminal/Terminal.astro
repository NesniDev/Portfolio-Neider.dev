<section>
  <header
    class="flex items-center justify-between bg-[#01191f] font-code text-xs border border-gray-800 border-l-0 px-6 py-1"
  >
    <div
      class="flex items-center gap-4 text-gray-400 transition-all duration-300"
    >
      <span class="bg-[#072c35ad] py-1 px-2 rounded-sm text-white"
        >TERMINAL</span
      >
      <span class="transition hover:text-white">PROBLEMS</span>
      <span class="transition hover:text-white">OUTPUT</span>
    </div>
  </header>

  <div
    class="relative flex flex-col gap-1 text-white font-jetbrains text-xs px-6 py-2"
  >
    <p>$ npm run dev</p>
    <p class="text-[#4ade80]">
      ready - started server on 0.0.0.0:3000, url: http://localhost:3000
    </p>
    <p>info - Loaded env from /portfolio/.env.local</p>
    <p class="text-[#4ade80]">✓ Compiled successfully in 1.2s</p>
    <p class="text-[#4ade80]">✓ Compiled / in 234ms</p>
    <p class="cursor">~/portfolio $</p>
  </div>

  <style>
    .cursor {
      display: flex;
      align-items: center;
    }

    .cursor::after {
      content: '';
      display: inline-block;
      width: 4px;
      height: 16px;
      background-color: #4ade80;
      margin-left: 4px;
      animation: blink 1s step-start infinite;
    }
    @keyframes blink {
      0% {
        opacity: 0;
      }
      50% {
        opacity: 1;
      }
      100% {
        opacity: 0;
      }
    }
  </style>
</section>
