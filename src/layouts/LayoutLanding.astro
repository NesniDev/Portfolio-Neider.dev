---
import SEO from '@/components/SEO.astro'

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props

import '../styles/global.css'
---

<!doctype html>
<html lang="es">
  <head>
    <SEO title={title} description={description} />
  </head>

  <body>
    <section class="layout-editor">
      <header id="header">
        <slot name="header" />
      </header>

      <aside id="bar-left">
        <slot name="bar-left" />
      </aside>

      <section id="tab">
        <slot name="tab" />
      </section>

      <section id="explorer">
        <slot name="explorer" />
      </section>

      <main id="content" class="flex flex-col justify-start items-start">
        <slot name="content" />
      </main>

      <aside id="bar-right">
        <slot name="bar-right" />
      </aside>

      <div id="terminal">
        <slot name="terminal" />
      </div>

      <footer id="footer">
        <slot name="footer" />
      </footer>
    </section>
  </body>
</html>

<style is:global>
  body {
    scroll-behavior: smooth;
  }

  .layout-editor {
    display: grid;
    width: 100%;
    height: 100vh;

    grid-template-areas:
      'header   header   header   header    header'
      'bar-left explorer tab      tab       tab'
      'bar-left explorer content  content   bar-right'
      'bar-left explorer terminal terminal  bar-right'
      'footer   footer   footer   footer    footer';

    grid-template-columns: auto 3fr 8fr 8fr auto;
    grid-template-rows: auto auto 1fr auto auto;

    overflow: hidden;
  }

  /* --- Áreas de la interfaz --- */
  #header {
    grid-area: header;
    background: #000f13;
    border-bottom: 1px solid #2a2a2a;
  }
  #bar-left {
    grid-area: bar-left;
    background: #000f13;
    border-right: 1px solid #2a2a2a;
  }
  #explorer {
    grid-area: explorer;
    background: #01191f;
    border-right: 1px solid #2a2a2a;
  }
  #content {
    grid-area: content;
    background: #01191f;

    height: 100%;
    min-height: 0;

    overflow-y: auto;

    display: block;

    scrollbar-color: #4ade80 #01191f;
    scrollbar-width: thin;
  }
  #tab {
    grid-area: tab;
    background: #01191f;
    align-self: flex-start;
  }
  #bar-right {
    grid-area: bar-right;
    background: #01191f;
  }
  #terminal {
    grid-area: terminal;
    background: #000000;
  }
  #footer {
    grid-area: footer;
    background: #4ade80;
  }
</style>
