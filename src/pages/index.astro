---
import Header from '@/components-landing/header/Header.astro'
import LayoutLanding from '../layouts/LayoutLanding.astro'
import BarLeft from '../components-landing/aside-left/BarLeft.astro'
import Explorer from '../components-landing/explorer/Explorer.astro'
import { ViewContent } from '../components-landing/react/viewContent'
import Terminal from '../components-landing/terminal/Terminal.astro'
import Footer from '../components-landing/footer/Footer.astro'
import { ContentViewer } from '../components-landing/tabs/Tabs.jsx'
import { BreadCrumbs } from '../components-landing/react/BreadCrumbs.jsx'
import BarRight from '@/components-landing/aside-right/BarRight.astro'
---

<LayoutLanding title="Neider Nieto | Ingeniero de Sistemas & Desarrollador Web" description="Portfolio profesional de Neider Nieto - Ingeniero de Sistemas especializado en desarrollo frontend con React, Astro, JavaScript y TypeScript. Disponible para proyectos freelance.">
  <Header slot="header" />

  <BarLeft slot="bar-left" />

  <Explorer slot="explorer" />

  <div slot="content" class="flex flex-col w-full h-full overflow-hidden">
    <div class="w-full flex flex-col shrink-0">
      <ContentViewer client:load />
      <BreadCrumbs client:load />
    </div>

    <div class="flex-1 overflow-y-auto">
      <ViewContent client:load />
    </div>
  </div>

  <Terminal slot="terminal" />

  <BarRight slot="bar-right" />

  <Footer slot="footer" />
</LayoutLanding>

<script>
  const barRight = document.getElementById('bar-right') as HTMLElement

  function playToggleSound(show: boolean) {
    const ctx = new AudioContext()
    const now = ctx.currentTime

    if (show) {
      // Ascending double-blip: panel opening
      const osc1 = ctx.createOscillator()
      const gain1 = ctx.createGain()
      osc1.type = 'sine'
      osc1.frequency.setValueAtTime(600, now)
      osc1.frequency.exponentialRampToValueAtTime(900, now + 0.06)
      gain1.gain.setValueAtTime(0.18, now)
      gain1.gain.exponentialRampToValueAtTime(0.001, now + 0.12)
      osc1.connect(gain1).connect(ctx.destination)
      osc1.start(now)
      osc1.stop(now + 0.12)

      const osc2 = ctx.createOscillator()
      const gain2 = ctx.createGain()
      osc2.type = 'sine'
      osc2.frequency.setValueAtTime(900, now + 0.08)
      osc2.frequency.exponentialRampToValueAtTime(1200, now + 0.16)
      gain2.gain.setValueAtTime(0, now)
      gain2.gain.setValueAtTime(0.18, now + 0.08)
      gain2.gain.exponentialRampToValueAtTime(0.001, now + 0.22)
      osc2.connect(gain2).connect(ctx.destination)
      osc2.start(now + 0.08)
      osc2.stop(now + 0.22)
    } else {
      // Descending single tone: panel closing
      const osc = ctx.createOscillator()
      const gain = ctx.createGain()
      osc.type = 'sine'
      osc.frequency.setValueAtTime(800, now)
      osc.frequency.exponentialRampToValueAtTime(400, now + 0.1)
      gain.gain.setValueAtTime(0.15, now)
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.15)
      osc.connect(gain).connect(ctx.destination)
      osc.start(now)
      osc.stop(now + 0.15)
    }

    setTimeout(() => ctx.close(), 400)
  }

  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey && e.altKey && e.key.toLowerCase() === 'b') {
      barRight.classList.toggle('hidden')
      playToggleSound(!barRight.classList.contains('hidden'))
    }
  })
</script>
