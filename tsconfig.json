{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@/components": [
        "src/legacy/components/*"
      ],
      "@/icons": [
        "src/icons/*"
      ],
      "@/layots": [
        "@/layouts/*"
      ],
      "@/pages": [
        "src/pages/*"
      ],
      "@/components-landing": [
        "src/components-landing/*"
      ]
    }

  }
}